      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún micrófono"
          }
        }
      }
    },
    "No results": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin resultados"
          }
        }
      }
    },
    "None (mouse only)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna (solo ratón)"
          }
        }
      }
    },
    "Nothing copied yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no has copiado nada"
          }
        }
      }
    },
    "Only an approximate location (about 11 km) is sent. [Weather data by Open-Meteo.com](https://open-meteo.com/) (CC BY 4.0).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se envía una ubicación aproximada (unos 11 km). [Datos del clima de Open-Meteo.com](https://open-meteo.com/) (CC BY 4.0)."
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes del Sistema"
          }
        }
      }
    },
    "Open the Penknife menu": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir el menú de Penknife"
          }
        }
      }
    },
    "Open the history": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir el historial"
          }
        }
      }
    },
    "Partly cloudy": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcialmente nublado"
          }
        }
      }
    },
    "Paste": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar"
          }
        }
      }
    },
    "Paste after choosing an item": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar al elegir un elemento"
          }
        }
      }
    },
    "Paused automatically while Apple Music or iTunes is your music player.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pausa solo mientras Apple Music o iTunes sea tu reproductor de música."
          }
        }
      }
    },
    "Paused: Apple Music is your music player.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa: Apple Music es tu reproductor de música."
          }
        }
      }
    },
    "Penknife — the pocket knife for your Mac": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Penknife — la navaja para tu Mac"
          }
        }
      }
    },
    "Penknife's own Touch Bar: battery, brightness, keyboard light, actions, music, weather, CPU temperature, volume and time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch Bar propia de Penknife: batería, brillo, luz del teclado, acciones, música, clima, temperatura de la CPU, volumen y hora."
          }
        }
      }
    },
    "Permissions": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permisos"
          }
        }
      }
    },
    "Pin": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijar"
          }
        }
      }
    },
    "Pinned": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijados"
          }
        }
      }
    },
    "Pinned items are kept.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos fijados se conservan."
          }
        }
      }
    },
    "Pinned items are saved on this Mac and never deleted unless you remove them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos fijados se guardan en este Mac y nunca se borran salvo que los quites tú."
          }
        }
      }
    },
    "Play or pause": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducir o pausar"
          }
        }
      }
    },
    "Play, pause and skip songs. On the Touch Bar: one tap plays or pauses, two go to the next song, three to the previous one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce, pausa y cambia de canción. En la Touch Bar: un toque reproduce o pausa, dos pasan a la siguiente canción, tres a la anterior."
          }
        }
      }
    },
    "Player": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproductor"
          }
        }
      }
    },
    "Previous track": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canción anterior"
          }
        }
      }
    },
    "Quit Penknife": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de Penknife"
          }
        }
      }
    },
    "Rain": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lluvia"
          }
        }
      }
    },
    "Redo": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehacer"
          }
        }
      }
    },
    "Remembers what you copy (text, images and files) so you can search it and paste it again. Passwords are skipped. Only pinned items are kept after quitting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerda lo que copias (texto, imágenes y archivos) para buscarlo y volver a pegarlo. Las contraseñas se ignoran. Al salir solo se conservan los elementos fijados."
          }
        }
      }
    },
    "Screenshot": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura de pantalla"
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "es": {
          "stringUnit": {
