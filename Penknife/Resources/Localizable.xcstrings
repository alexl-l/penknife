      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld segundos"
          }
        }
      }
    },
    "A module that is off uses no CPU or memory.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un módulo apagado no usa CPU ni memoria."
          }
        }
      }
    },
