          }
        }
      }
    },
    "Keeps Apple Music from opening by itself (headphones, play key). Opening it yourself still works.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Impide que Apple Music se abra sola (auriculares, tecla de reproducir). Abrirla tú sigue funcionando."
          }
        }
      }
    },
    "Keeps the Mac and the display awake without moving the mouse. Turns off when the Mac locks.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el Mac y la pantalla despiertos sin mover el ratón. Se desactiva al bloquear el Mac."
          }
        }
      }
    },
    "Keeps what you copy (text, images, files) so you can search and paste it again. Passwords are skipped. After you quit, only pinned items remain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda lo que copias (texto, imágenes y archivos) para buscarlo y pegarlo de nuevo. Las contraseñas se ignoran. Al salir, solo quedan los elementos fijados."
          }
        }
      }
    },
    "Keeps you shown as active by nudging the mouse when you stop for a while.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te mantiene como activo moviendo el ratón cuando haces una pausa."
          }
