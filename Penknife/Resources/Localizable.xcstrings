    "When you press the shortcut, the meeting and the Mac's microphone are muted together. Turn off to mute only the meeting. With no meeting, the Mac's microphone is muted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al pulsar el atajo, se silencia la reunión y también el micrófono del Mac. Si lo desactivas, solo la reunión. Sin reunión, siempre se silencia el Mac."
          }
        }
      }
    },
