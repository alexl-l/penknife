          }
        }
      }
    },
    "Mouse jiggler": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover ratón"
          }
        }
      }
    },
    "Mouse jiggler needs the Accessibility permission": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Mover ratón» necesita el permiso de Accesibilidad"
          }
        }
      }
    },
    "Mouse jiggler off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover ratón desactivado"
          }
        }
      }
    },
    "Mouse jiggler on": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover ratón activado"
          }
        }
      }
    },
    "Mouse jiggler, off": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover ratón, desactivado"
          }
        }
      }
    },
    "Mouse jiggler, on": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover ratón, activado"
          }
        }
      }
    },
    "Moves the mouse after 10 seconds without activity, so you stay active.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el ratón tras 10 segundos sin actividad, para que sigas como activo."
          }
        }
      }
    },
    "Music": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Música"
          }
        }
      }
    },
    "Music. One tap plays or pauses, two go to the next song, three to the previous one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Música. Un toque reproduce o pausa, dos pasan a la siguiente canción, tres a la anterior."
          }
        }
      }
    },
    "Mute microphone": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciar micrófono"
          }
        }
      }
    },
    "Mutes and unmutes the microphone, in sync with Microsoft Teams and Google Meet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencia y activa el micrófono, sincronizado con Microsoft Teams y Google Meet."
          }
        }
      }
    },
    "Native dialogs": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diálogos nativos"
          }
        }
      }
    },
    "Needed for the mouse jiggler, the Teams microphone sync and dialog detection.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para mover el ratón, sincronizar el micrófono con Teams y detectar diálogos."
          }
        }
      }
    },
    "Next track": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canción siguiente"
          }
        }
      }
    },
    "No microphone found": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún micrófono"
          }
        }
      }
    },
    "None (mouse only)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna (solo ratón)"
          }
        }
      }
    },
    "Only an approximate location (about 11 km) is sent. [Weather data by Open-Meteo.com](https://open-meteo.com/) (CC BY 4.0).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se envía una ubicación aproximada (unos 11 km). [Datos del clima de Open-Meteo.com](https://open-meteo.com/) (CC BY 4.0)."
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes del Sistema"
          }
        }
      }
    },
    "Open the Penknife menu": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir el menú de Penknife"
          }
        }
      }
    },
    "Partly cloudy": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcialmente nublado"
          }
        }
      }
    },
    "Paste": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegar"
          }
        }
      }
    },
    "Paused automatically while Apple Music or iTunes is your music player.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pausa solo mientras Apple Music o iTunes sea tu reproductor de música."
          }
        }
      }
    },
    "Paused: Apple Music is your music player.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa: Apple Music es tu reproductor de música."
          }
        }
      }
    },
    "Penknife — the pocket knife for your Mac": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Penknife — la navaja para tu Mac"
          }
        }
      }
    },
    "Penknife's own Touch Bar: battery, brightness, keyboard light, actions, music, weather, CPU temperature, volume and time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch Bar propia de Penknife: batería, brillo, luz del teclado, acciones, música, clima, temperatura de la CPU, volumen y hora."
          }
        }
      }
    },
    "Permissions": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permisos"
          }
        }
      }
    },
    "Play or pause": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducir o pausar"
          }
        }
      }
    },
    "Play, pause and skip songs. On the Touch Bar: one tap plays or pauses, two go to the next song, three to the previous one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce, pausa y cambia de canción. En la Touch Bar: un toque reproduce o pausa, dos pasan a la siguiente canción, tres a la anterior."
          }
        }
      }
    },
    "Player": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproductor"
          }
        }
      }
    },
    "Previous track": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canción anterior"
          }
        }
      }
    },
    "Quit Penknife": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de Penknife"
          }
        }
      }
    },
    "Rain": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lluvia"
          }
        }
      }
    },
    "Redo": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehacer"
          }
        }
      }
    },
    "Screenshot": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura de pantalla"
          }
        }
      }
    },
    "Select All": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionar todo"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes…"
          }
        }
      }
    },
    "Shortcuts": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atajos"
          }
        }
      }
    },
    "Shortcuts of modules that are off are disabled. On a Mac without Touch Bar, F keys need Fn or “Use F1, F2, etc. keys as standard function keys”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de los módulos apagados están desactivados. En un Mac sin Touch Bar, las teclas F necesitan Fn o «Usar las teclas F1, F2, etc. como teclas de función estándar»."
          }
        }
      }
    },
    "Show confirmations for": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar confirmaciones durante"
          }
        }
      }
    },
    "Shows the CPU temperature on the Touch Bar and in the menu.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la temperatura de la CPU en la Touch Bar y en el menú."
          }
        }
      }
    },
    "Shows the current weather on the Touch Bar and in the menu, using your approximate location.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el clima actual en la Touch Bar y en el menú, con tu ubicación aproximada."
          }
        }
      }
    },
    "Snow": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieve"
          }
        }
      }
    },
    "Takes a screenshot of an area and copies it to the clipboard.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura un área de la pantalla y la copia al portapapeles."
          }
        }
      }
    },
    "The language follows the system (Spanish or English).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma sigue al del sistema (español o inglés)."
          }
        }
      }
    },
    "Thunderstorm": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tormenta"
          }
        }
      }
    },
    "Touch Bar": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch Bar"
          }
        }
      }
    },
    "Turn on when unlocking, off when locking": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar al desbloquear y desactivar al bloquear"
          }
        }
      }
    },
    "Turns off the mouse jiggler and locks the screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva «Mover ratón» y bloquea la pantalla."
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión"
          }
        }
      }
    },
    "Volume": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen"
          }
        }
      }
    },
    "Weather": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clima"
          }
        }
      }
    },
    "Weather: %@, %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clima: %1$@, %2$@"
          }
        }
      }
    },
    "Weather: location not allowed. Tap to open the settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clima: ubicación no permitida. Toca para abrir los ajustes."
          }
        }
      }
    },
    "Weather: no data yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clima: aún sin datos"
          }
        }
      }
    },
    "While a dialog or system prompt is in front, the Touch Bar shows its own buttons.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras haya un diálogo o aviso del sistema delante, el Touch Bar muestra sus propios botones."
          }
        }
      }
    },
    "Window": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventana"
          }
        }
      }
    }
  },
  "version": "1.0"
}
