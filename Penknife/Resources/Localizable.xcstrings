      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un área o, con Espacio, una ventana. Márcala con flechas, texto, marcador, rectángulos, círculos, lápiz o desenfoque y luego cópiala o guárdala. No se sube nada a internet."
          }
        }
      }
    },
