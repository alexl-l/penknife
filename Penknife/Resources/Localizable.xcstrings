    "Close sliders and the date automatically": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar los deslizadores y la fecha automáticamente"
          }
        }
      }
    },
    "Closes Apple Music when it opens by itself, e.g. with the play key.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra Apple Music cuando se abre solo, por ejemplo con la tecla de reproducir."
          }
        }
      }
    },
    "Cloudy": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
