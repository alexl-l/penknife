      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch Bar"
          }
        }
      }
    },
    "Turn on when unlocking, off when locking": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar al desbloquear y desactivar al bloquear"
          }
        }
      }
    },
    "Turns off the mouse jiggler and locks the screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva «Mover ratón» y bloquea la pantalla."
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer"
          }
        }
      }
    },
