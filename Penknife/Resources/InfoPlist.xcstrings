    "NSAppleEventsUsageDescription": {
      "comment": "Privacy - AppleEvents Sending Usage Description",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Penknife controla tu reproductor de música y sincroniza el micrófono con Google Meet en Chrome."
